# [필수] 디스코드 봇 토큰 (Discord Developer Portal -> Bot -> Reset Token 에서 복사)
DISCORD_BOT_TOKEN=your_bot_token_here

# [권장] 보안을 위해 본인의 디스코드 사용자 ID만 봇을 쓸 수 있도록 제한
# 디스코드 설정 -> 고급 -> '개발자 모드' 켜고, 내 프로필 우클릭 -> '사용자 ID 복사'
ALLOWED_USER_ID=

# [선택] 기본 작업 디렉토리 (기본값: C:\utube)
DEFAULT_WORKSPACE=C:\utube

# [선택] 안티그래비티 실행 파일 경로 (비워두면 C:\Users\ihavg\.gemini\bin\agy.exe 자동 탐색)
AGY_PATH=C:\Users\ihavg\.gemini\bin\agy.exe

# [선택] 파일 수정/명령 실행 자동 승인 (원격 제어 자율 모드: true, 기본값: true)
AUTO_APPROVE=true

